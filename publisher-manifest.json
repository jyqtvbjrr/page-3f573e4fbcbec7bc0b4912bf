gin-top: 1.5rem;padding-top: 1.5rem;border-top: 1px dashed var(--border-subtle);font-size: 0.875rem;color: var(--slate-light)}\n\n  /* Client & Usage Instructions */\n  .usage-container {display: grid;grid-template-columns: 2fr 1fr;gap: 3rem;background: var(--white);padding: 3rem;border-radius: 12px;border: 1px solid var(--border-subtle)}\n\n  .step-list {counter-reset: step-counter;list-style: none}\n\n  .step-item {margin-bottom: 2rem;position: relative;padding-left: 3rem}\n\n  .step-item::before {counter-increment: step-counter;content: counter(step-counter);position: absolute;left: 0;top: 0;width: 2rem;height: 2rem;background: var(--slate-dark);color: var(--white);border-radius: 50%;display: flex;align-items: center;justify-content: center;font-weight: 700;font-size: 0.9rem}\n\n  .step-item h3 {font-size: 1.125rem;color: var(--slate-dark);margin-bottom: 0.5rem}\n\n  .step-item p {color: var(--slate-mid);font-size: 0.95rem}\n\n  .client-sidebar {background: var(--bg-color);padding: 2rem;border-radius: 8px;height: fit-content}\n\n  .client-sidebar h3 {margin-bottom: 1.5rem;color: var(--slate-dark);font-size: 1.125rem}\n\n  .device-support {display: flex;flex-wrap: wrap;gap: 0.5rem}\n\n  .tag {background: var(--white);border: 1px solid var(--border-subtle);padding: 0.4rem 0.8rem;border-radius: 4px;font-size: 0.85rem;color: var(--slate-mid)}\n\n  /* FAQ Section - Numbered List */\n  .faq-list {display: flex;flex-direction: column;gap: 1rem}\n\n  .faq-item {background: var(--white);border: 1px solid var(--border-subtle);border-radius: 8px;padding: 1.5rem;transition: all 0.2s}\n\n  .faq-question {font-weight: 700;color: var(--slate-dark);margin-bottom: 0.75rem;display: flex;align-items: center;gap: 0.75rem}\n\n  .faq-num {color: var(--cyan-accent);font-size: 0.9rem;font-weight: 800}\n\n  .faq-answer {color: var(--slate-mid);font-size: 0.95rem;padding-left: 2rem;line-height: 1.7}\n\n  footer {text-align: center;padding: 3rem 0;color: var(--slate-light);font-size: 0.85rem;border-top: 1px solid var(--border-subtle);margin-top: 4rem}\n\n  @media (max-width: 768px) {\n    .hero {grid-template-columns: 1fr;gap: 2rem;padding: 3rem 0}\n    \n    .hero-text h1 {font-size: 2.5rem}\n\n    .nav-links {display: none;/* Simplified for mobile in this static demo */}\n\n    .usage-container {grid-template-columns: 1fr}\n\n    .plan-header {flex-direction: column;align-items: flex-start;gap: 0.5rem}\n  }\n</style><nav>\n  <a href=\"#\" class=\"nav-brand\">Rhodes</a>\n  <div class=\"nav-links\">\n    <a href=\"#plans\">套餐详情</a>\n    <a href=\"#usage\">使用指南</a>\n    <a href=\"#faq\">常见问题</a>\n  </div>\n</nav>\n\n<main>\n  \n  <section class=\"hero\">\n    <div class=\"hero-text\">\n      <h1>Rhodes 网络服务接入点</h1>\n      <p>提供稳定、高速的全球互联网访问通道。基于标准化协议构建，支持多终端无缝切换，专为需要高效数据交换的用户设计。</p>\n    </div>\n    <div class=\"hero-panel\">\n      <div class=\"panel-title\">系统状态概览</div>\n      <div class=\"status-item\">\n        <span>当前负载模式</span>\n        <span class=\"status-value\">均衡分布</span>\n      </div>\n      <div class=\"status-item\">\n        <span>线路优化策略</span>\n        <span class=\"status-value\">智能路由</span>\n      </div>\n      <div class=\"status-item\">\n        <span>最大并发设备数</span>\n        <span class=\"status-value\">依套餐而定</span>\n      </div>\n      <div class=\"status-item\">\n        <span>流媒体解锁范围</span>\n        <span class=\"status-value\">原生 IP</span>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"plans\">\n    <div class=\"section-header\">\n      <h2>订阅方案</h2>\n      <p>根据流量需求与设备数量选择适合的层级。所有方案均包含基础安全防护与标准客服支持。</p>\n  </div>\n\n    <div class=\"plans-list\">\n      \n      <article class=\"plan-card\">\n        <div class=\"plan-header\">\n          <h3 class=\"plan-name\">基础版</h3>\n          <div class=\"plan-price\">¥15 <span>/月</span></div>\n        </div>\n        <ul class=\"features-grid\">\n          <li class=\"feature-item\"><div class=\"feature-icon\"></div>每月 100GB 极速流量</li>\n          <li class=\"feature-item\"><div class=\"feature-icon\"></div>支持 3 台设备同时在线</li>\n          <li class=\"feature-item\"><div class=\"feature-icon\"></div>解锁基础流媒体内容</li>\n          <li class=\"feature-item\"><div class=\"feature-icon\"></div>普通线路节点池接入</li>\n        </ul>\n        <div class=\"annual-note\">按年付仅需 ¥150/年（相当于每月节省 ¥0）</div>\n      </article>\n\n      \n      <article class=\"plan-card featured\">\n        <div class=\"featured-badge\">推荐首选</div>\n        <div class=\"plan-header\">\n          <h3 class=\"plan-name\">旗舰版</h3>\n          <div class=\"plan-price\">¥35 <span>/月</span></div>\n        </div>\n        <ul class=\"features-grid\">\n          <li class=\"feature-item\"><div class=\"feature-icon\"></div>每月 300GB 极速流量</li>\n          <li class=\"feature-item\"><div class=\"feature-icon\"></div>支持 5 台设备同时在线</li>\n          <li class=\"feature-item\"><div class=\"feature-icon\"></div>全节点原生流媒体解锁</li>\n          <li class=\"feature-item\"><div class=\"feature-icon\"></div>IPLC 专线游戏加速优化</li>\n          <li class=\"feature-item\"><div class=\"feature-icon\"></div>7x24 优先工单支持</li>\n        </ul>\n        <div class=\"annual-note\">按年付仅需 ¥350/年（相当于每月节省约 ¥4.2）</div>\n      </article>\n\n      \n      <article class=\"plan-card\">\n        <div class=\"plan-header\">\n          <h3 class=\"plan-name\">团队版</h3>\n          <div class=\"plan-price\">¥85 <span>/月</span></div>\n        </div>\n        <ul class=\"features-grid\">\n          <li class=\"feature-item\"><div class=\"feature-icon\"></div>每月 1000GB 极速流量</li>\n          <li class=\"feature-item\"><div class=\"feature-icon\"></div>支持 20 台设备同时在线</li>\n          <li class=\"feature-item\"><div class=\"feature-icon\"></div>VIP 专属高带宽节点</li>\n          <li class=\"feature-item\"><div class=\"feature-icon\"></div>支持企业定制路由规则</li>\n          <li class=\"feature-item\"><div class=\"feature-icon\"></div>专属客户经理一对一服务</li>\n        </ul>\n        <div class=\"annual-note\">按年付仅需 ¥850/年（相当于每月节省约 ¥14.2）</div>\n      </article>\n    </div>\n  </section>\n\n  \n  <section id=\"usage\">\n    <div class=\"section-header\">\n      <h2>客户端配置与使用说明</h2>\n      <p>请按照以下步骤完成初始设置，以确保连接稳定性与安全性。</p>\n    </div>\n\n    <div class=\"usage-container\">\n      <div class=\"steps-area\">\n        <ol class=\"step-list\">\n          <li class=\"step-item\">\n            <h3>获取订阅链接</h3>\n            <p>登录 Rhodes 用户中心，复制您的专属订阅 URL。请勿将此链接泄露给第三方，以免账号被盗用。</p>\n          </li>\n          <li class=\"step-item\">\n            <h3>选择兼容客户端</h3>\n            <p>根据您的操作系统下载并安装主流代理客户端软件。确保软件版本保持最新以支持最新的加密协议。</p>\n          </li>\n          <li class=\"step-item\">\n            <h3>导入配置文件</h3>\n            <p>在客户端中选择“添加订阅”或“从 URL 导入”，粘贴第一步获取的链接。系统将自动解析节点列表与分流规则。</p>\n          </li>\n          <li class=\"step-item\">\n            <h3>测试连接速度</h3>\n            <p>启用“全局模式”或“规则模式”进行初步测试。建议先尝试延迟最低的节点，若出现不稳定情况，可手动切换至备用节点。</p>\n          </li>\n        </ol>\n      </div>\n      \n      <aside class=\"client-sidebar\">\n        <h3>支持的设备环境</h3>\n        <div class=\"device-support\">\n          <span class=\"tag\">Windows</span>\n          <span class=\"tag\">macOS</span>\n          <span class=\"tag\">iOS</span>\n          <span class=\"tag\">Android</span>\n          <span class=\"tag\">Linux</span>\n        </div>\n        <p>\n          注：具体客户端软件需自行搜索官方渠道下载，本页面不提供直接安装包下载链接。\n        </p>\n      </aside>\n    </div>\n  </section>\n\n  \n  <section id=\"faq\">\n    <div class=\"section-header\">\n      <h2>常见问题解答</h2>\n      <p>关于账户管理、流量计算及服务范围的常见疑问。</p>\n    </div>\n\n    <div class=\"faq-list\">\n      <article class=\"faq-item\">\n        <div class=\"faq-question\">\n          <span class=\"faq-num\">Q1</span>\n          <span>流量是如何计算的？</span>\n        </div>\n        <div class=\"faq-answer\">\n          流量统计基于上行与下行数据的总和。通常而言，浏览网页产生的流量较小，而观看高清视频或下载大文件会显著消耗配额。当月剩余流量可在用户中心实时查看。\n        </div>\n      </article>\n\n      <article class=\"faq-item\">\n        <div class=\"faq-question\">\n          <span class=\"faq-num\">Q2</span>\n          <span>如果超出月度流量限制怎么办？</span>\n        </div>\n        <div class=\"faq-answer\">\n          当月度流量耗尽时，服务将暂时中断，直至下一个计费周期开始。部分套餐允许单独购买额外流量包，具体选项请在后台查看是否开放该功能。\n        </div>\n      </article>\n\n      <article class=\"faq-item\">\n        <div class=\"faq-question\">\n          <span class=\"faq-num\">Q3</span>\n          <span>为什么某些网站无法访问？</span>\n        </div>\n        <div class=\"faq-answer\">\n          这可能是由于目标网站的地理封锁策略或当前节点的路由问题。建议尝试切换不同的节点线路，或检查客户端的分流规则是否正确匹配了域名。\n        </div>\n      </article>\n\n      <article class=\"faq-item\">\n        <div class=\"faq-question\">\n          <span class=\"faq-num\">Q4</span>\n          <span>可以中途升级套餐吗？</span>\n        </div>\n        <div class=\"faq-answer\">\n          支持随时升级套餐。升级后，原套餐剩余的未使用流量通常会合并到新套餐中，或者根据平台政策按比例折算差价。降级操作通常在当前计费周期结束后生效。\n        </div>\n      </article>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <p>© 2023-2024 Rhodes Network Services. All rights reserved.</p>\n  <p>仅供技术研究与合法用途参考，请遵守当地法律法规。</p>\n</footer>",
